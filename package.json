{
  "name": "prihoda-ai-air-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Příhoda AI Air Studio – koncept AI návrháře tkaninových vyústek s 3D vizualizací proudění a živou CFD simulací",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:web": "vite build --mode web",
    "serve:local": "node scripts/netlify-local.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test:engine": "node scripts/engine-check.mjs",
    "test:robust": "node scripts/robustness.mjs",
    "test:cfd": "node scripts/cfd-check.mjs",
    "mock": "node scripts/mock-claude.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@netlify/blobs": "^11.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
